{
  "manifest_version": 3,
  "name": "EDM",
  "version": "0.1.2",
  "description": "High-performance live download dashboard and acceleration integration for EDM",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "notifications",
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EDM Live Dashboard",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "edm@suvesh.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
