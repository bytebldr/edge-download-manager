{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "EDM",
  "version": "0.1.4",
  "identifier": "com.edm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EDM — Evo Download Manager v0.1.4",
        "url": "index.html",
        "width": 950,
        "height": 660,
        "minWidth": 950,
        "minHeight": 660,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://api.github.com https://github.com ws://127.0.0.1:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "bytebldr",
    "copyright": "Copyright (c) 2026 bytebldr (GPL-3.0-only)",
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../target/release/edm-nmh.exe",
      "../../../assets/vendor/manifests/com.edm.nmh.json",
      "../../../assets/vendor/win-x64/WebView2Loader.dll"
    ]
  }
}
